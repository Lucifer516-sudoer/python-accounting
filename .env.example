# Copy to .env to override the defaults used by docker-compose.yml. Docker
# Compose reads .env automatically; without it the same throwaway values apply.
# These are local development credentials, not secrets -- never put real ones
# here (.env is gitignored, this example is not).
POSTGRES_USER=accounting
POSTGRES_PASSWORD=accounting
POSTGRES_DB=accounting

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=accounting
MYSQL_USER=accounting
MYSQL_PASSWORD=accounting
